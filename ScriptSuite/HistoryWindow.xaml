<Window x:Class="ScriptSuite.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScriptSuite.ViewModels"
        xmlns:conv="clr-namespace:ScriptSuite.Converters"
        Title="Run History" Height="560" Width="860"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background.Primary}" Foreground="{DynamicResource Brush.Foreground.Primary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:OutcomeToBrushConverter x:Key="OutcomeToBrush" />

        <Style x:Key="HistoryTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}" />
        </Style>

        <Style x:Key="HistorySubtext" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="HistoryDetailText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- One run history row: when it ran, which script, its outcome, and
             the short summary. Outcome color matches the run window.
             Extended with collapsible per-row detail: log-file tail where a
             real file exists (DownloadsCleanup/EmptyFolderCleanup/ScreenshotsCleanup
             → CleanupLog.txt, SoftwareInventory → Software_Inventory.txt,
             SystemHealthReport → html, ClearEventLogs → EventLogBackups dir),
             otherwise Warning/Error stream fallback with explicit 'no file' message. -->
        <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
            <Border Background="{DynamicResource Brush.Background.Card}" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding When}" Foreground="{DynamicResource Brush.Foreground.Tertiary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource HistoryTitleText}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource HistorySubtext}"
                                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Border Grid.Column="2" Background="{Binding Outcome, Converter={StaticResource OutcomeToBrush}}" CornerRadius="4"
                                Padding="8,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Outcome}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Status.Success.Foreground}" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Expand affordance -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding ExpandButtonText}" Click="ToggleDetail_Click"
                                Tag="{Binding}" Padding="10,3" FontSize="12" />
                        <TextBlock Text="{Binding LogFileHint}" Foreground="{DynamicResource Brush.Foreground.Tertiary}" FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    </StackPanel>

                    <!-- Expanded detail: log file tail or no-file message, with open actions -->
                    <Border Background="{DynamicResource Brush.Background.Primary}" CornerRadius="6" Margin="0,8,0,0" Padding="10"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Detail" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Primary}" FontSize="12" />
                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ExpandedDetail}" Style="{StaticResource HistoryDetailText}" />
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasLogFile, Converter={StaticResource BoolToVis}}">
                                <Button Content="Open log file" Click="OpenLogFile_Click" Tag="{Binding}" Padding="10,3" FontSize="12" Margin="0,0,8,0" />
                                <Button Content="Open folder" Click="OpenFolder_Click" Tag="{Binding}" Padding="10,3" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Run History" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Foreground.Primary}" />
                <TextBlock x:Name="CountText" Text="" Style="{StaticResource HistorySubtext}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Close" Click="CloseButton_Click" Padding="18,8"
                        AutomationProperties.Name="Close run history" />
            </StackPanel>
        </Grid>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyMessage" Grid.Row="1" Text="No runs recorded yet — run a script to see its history here."
                   Foreground="{DynamicResource Brush.Foreground.Tertiary}" Margin="0,18,0,6" />

        <!-- Basic list: most recent first (Milestone 10). No search/filter yet -
             Phase 4 adds that on top of this same data. -->
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryList" />
        </ScrollViewer>
    </Grid>
</Window>

