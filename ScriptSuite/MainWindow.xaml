<Window x:Class="ScriptSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScriptSuite.ViewModels"
        mc:Ignorable="d"
        Title="Script Suite" Height="640" Width="980"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E" Foreground="#FFCDD6F4">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ScriptTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFCDD6F4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFBAC2DE" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF89B4FA" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FF313244" />
            <Setter Property="Foreground" Value="#FFCDD6F4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF45475A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One script row on the dashboard -->
        <DataTemplate DataType="{x:Type vm:ScriptRowViewModel}">
            <Border Background="#FF313244" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26E8;" FontSize="14" Foreground="#FFF9C74F"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowAdminShield, Converter={StaticResource BoolToVis}}"
                                       AutomationProperties.Name="Requires administrator" />
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ScriptTitleText}"
                                       Margin="{Binding ShowAdminShield, Converter={StaticResource MarginConverter}, ConverterParameter=8}" />
                            <Border Background="#FFC4956A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowCustomBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Custom" FontSize="11" FontWeight="SemiBold" Foreground="#FF1E1E2E" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource DescriptionText}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                            <TextBlock Text="◷" Foreground="#FF89B4FA" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding ScheduleSummary}" Foreground="#FF89B4FA" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <CheckBox IsChecked="{Binding RunAllIncluded}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  AutomationProperties.Name="{Binding DisplayName, StringFormat=Include in Run All for {0}}">
                            <TextBlock Text="Run All" Foreground="#FFBAC2DE" />
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="Run" Click="RunButton_Click" Padding="12,4" Margin="0,0,8,0"
                                IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Run {0}}" />
                        <Button Content="Settings" Click="SettingsButton_Click" Padding="10,4" Margin="0,0,8,0"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Settings for {0}}" />
                        <Button Content="Schedule" Click="ScheduleButton_Click" Padding="10,4" Margin="0,0,8,0"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Schedule {0}}" />
                        <Button Content="Hide" Click="HideButton_Click" Padding="10,4"
                                IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding IsHidden, Converter={StaticResource InverseBoolToVis}}"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Hide {0}}" />
                        <Button Content="Show" Click="ShowButton_Click" Padding="10,4"
                                Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Show {0}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Script Suite" FontSize="26" FontWeight="Bold" Foreground="#FFCDD6F4" />
            <TextBlock Text="Dashboard" FontSize="16" Foreground="#FF6C7086" VerticalAlignment="Bottom" Margin="12,0,0,4" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ShowHiddenCheck" IsChecked="{Binding ShowHidden, Mode=TwoWay}"
                          VerticalAlignment="Center" AutomationProperties.Name="Show hidden scripts">
                    <TextBlock Text="Show hidden" Foreground="#FFBAC2DE" />
                </CheckBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="History" Click="HistoryButton_Click" Padding="16,8" Margin="0,0,8,0"
                        AutomationProperties.Name="Open run history" />
                <Button Content="Scheduled" Click="ScheduledHistoryButton_Click" Padding="16,8" Margin="0,0,8,0"
                        AutomationProperties.Name="Open scheduled history" />
                <Button x:Name="RunAllButton" Content="Run All" Click="RunAllButton_Click"
                        IsEnabled="{Binding RunAllEnabled}"
                        FontWeight="SemiBold" Padding="20,8" />
            </StackPanel>
        </Grid>

        <!-- Grouped script list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CategoryList" ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScriptCategoryViewModel}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeaderText}" />
                            <ItemsControl ItemsSource="{Binding Rows}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>