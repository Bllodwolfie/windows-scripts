<Window x:Class="ScriptSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScriptSuite.ViewModels"
        mc:Ignorable="d"
        Title="Script Suite" Height="640" Width="980"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background.Primary}" Foreground="{DynamicResource Brush.Foreground.Primary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ScriptTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>

        <!-- Theme toggle — circular 38px, card bg, 2px border, shadow, hover scale 1.1, matching SystemHealthReport.html .theme-toggle -->
        <Style x:Key="ThemeToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Background.Card.Hover}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="8" ShadowDepth="2" Direction="270" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One script row on the dashboard -->
        <DataTemplate DataType="{x:Type vm:ScriptRowViewModel}">
            <Border Background="{DynamicResource Brush.Background.Card}" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26E8;" FontSize="14" Foreground="{DynamicResource Brush.Status.Warning.Text}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowAdminShield, Converter={StaticResource BoolToVis}}"
                                       AutomationProperties.Name="Requires administrator" />
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ScriptTitleText}"
                                       Margin="{Binding ShowAdminShield, Converter={StaticResource MarginConverter}, ConverterParameter=8}" />
                            <Border Background="{DynamicResource Brush.Background.Badge.Custom}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowCustomBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Custom" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Peach.Foreground}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource DescriptionText}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                            <TextBlock Text="◷" Foreground="{DynamicResource Brush.Accent.Primary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding ScheduleSummary}" Foreground="{DynamicResource Brush.Accent.Primary}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <CheckBox IsChecked="{Binding RunAllIncluded}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  AutomationProperties.Name="{Binding DisplayName, StringFormat=Include in Run All for {0}}">
                            <TextBlock Text="Run All" Foreground="{DynamicResource Brush.Foreground.Secondary}" />
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="Run" Click="RunButton_Click" Padding="12,4" Margin="0,0,8,0"
                                IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Run {0}}" />
                        <Button Content="Settings" Click="SettingsButton_Click" Padding="10,4" Margin="0,0,8,0"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Settings for {0}}" />
                        <Button Content="Schedule" Click="ScheduleButton_Click" Padding="10,4" Margin="0,0,8,0"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Schedule {0}}" />
                        <Button Content="Hide" Click="HideButton_Click" Padding="10,4"
                                IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding IsHidden, Converter={StaticResource InverseBoolToVis}}"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Hide {0}}" />
                        <Button Content="Show" Click="ShowButton_Click" Padding="10,4"
                                Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Show {0}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Script Suite" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.Foreground.Primary}" />
                <TextBlock Text="Dashboard" FontSize="16" Foreground="{DynamicResource Brush.Foreground.Tertiary}" VerticalAlignment="Bottom" Margin="12,0,0,4" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="DashboardHelpButton" Content="?" Width="22" Height="22" FontSize="11" FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.Accent.Primary}" Background="Transparent" BorderBrush="{DynamicResource Brush.Accent.Primary}" BorderThickness="1"
                    Click="DashboardHelpButton_Click" VerticalAlignment="Center" AutomationProperties.Name="Help">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="11" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
        <Border x:Name="DashboardHelpPanel" Grid.Row="1" Background="{DynamicResource Brush.Background.Primary}" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="DashboardHelpText" Foreground="{DynamicResource Brush.Foreground.Secondary}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ShowHiddenCheck" IsChecked="{Binding ShowHidden, Mode=TwoWay}"
                          VerticalAlignment="Center" AutomationProperties.Name="Show hidden scripts">
                    <TextBlock Text="Show hidden" Foreground="{DynamicResource Brush.Foreground.Secondary}" />
                </CheckBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeToggleButton" Style="{StaticResource ThemeToggleButtonStyle}"
                        Click="ThemeToggleButton_Click" Margin="0,0,12,0" VerticalAlignment="Center"
                        AutomationProperties.Name="Toggle theme" ToolTip="Switch to Latte theme">
                    <Grid Width="22" Height="22">
                        <!-- Moon: M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z -->
                        <Path x:Name="MoonIcon" Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                              Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.9"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent" Stretch="Uniform" Visibility="Visible" />
                        <!-- Sun: circle r=5 + 8 rays -->
                        <Grid x:Name="SunIcon" Visibility="Collapsed">
                            <Ellipse Width="10" Height="10" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.9"
                                     Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- rays -->
                            <Line X1="11" Y1="1" X2="11" Y2="3.5" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="11" Y1="18.5" X2="11" Y2="21" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="1" Y1="11" X2="3.5" Y2="11" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="18.5" Y1="11" X2="21" Y2="11" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="3.9" Y1="3.9" X2="5.7" Y2="5.7" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="16.3" Y1="16.3" X2="18.1" Y2="18.1" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="3.9" Y1="18.1" X2="5.7" Y2="16.3" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="16.3" Y1="5.7" X2="18.1" Y2="3.9" Stroke="{DynamicResource Brush.Foreground.Primary}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Grid>
                </Button>
                <Button Content="History" Click="HistoryButton_Click" Padding="16,8" Margin="0,0,8,0"
                        AutomationProperties.Name="Open run history" />
                <Button Content="Scheduled" Click="ScheduledHistoryButton_Click" Padding="16,8" Margin="0,0,8,0"
                        AutomationProperties.Name="Open scheduled history" />
                <Button x:Name="RunAllButton" Content="Run All" Click="RunAllButton_Click"
                        IsEnabled="{Binding RunAllEnabled}"
                        FontWeight="SemiBold" Padding="20,8" />
            </StackPanel>
        </Grid>

        <!-- Grouped script list -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CategoryList" ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScriptCategoryViewModel}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeaderText}" />
                            <ItemsControl ItemsSource="{Binding Rows}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>

