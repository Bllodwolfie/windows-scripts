<UserControl x:Class="ScriptSuite.Controls.DownloadsAdvancedRulesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Expander Header="Advanced per-extension rules (overrides simple mode)" IsExpanded="False"
              Foreground="#FFBAC2DE" FontSize="12" Margin="0,10,0,0">
        <Border Background="#FF313244" CornerRadius="8" Padding="14,12" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Explicit rule for an extension overrides the simple &quot;Extensions to delete&quot; list and category moves. Extensions with no rule keep behaving as they do today. Ignore = never touch (even if old), Delete = to Recycle Bin, MoveTo = custom folder."
                           Foreground="#FF7F849C" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                <!-- Existing rules -->
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF45475A" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Extension -->
                                        <TextBox Grid.Column="0" Text="{Binding Extension, UpdateSourceTrigger=LostFocus}"
                                                 Padding="6,4" VerticalAlignment="Center" LostFocus="RuleExtension_LostFocus"
                                                 AutomationProperties.Name="Extension" />
                                        <!-- Action -->
                                        <ComboBox Grid.Column="1" SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="6,0,0,0" VerticalAlignment="Center"
                                                  SelectionChanged="RuleAction_Changed"
                                                  AutomationProperties.Name="Action"
                                                  ItemsSource="{Binding DataContext.ActionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <!-- Destination (only for MoveTo) -->
                                        <Grid Grid.Column="2" Margin="6,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Destination, UpdateSourceTrigger=LostFocus}"
                                                     Padding="6,4" VerticalAlignment="Center" LostFocus="RuleDestination_LostFocus"
                                                     AutomationProperties.Name="Destination"
                                                     Visibility="{Binding IsMoveTo, Converter={StaticResource BoolToVis}}" />
                                            <Button Grid.Column="1" Content="Browse…" Click="BrowseDestination_Click"
                                                    Padding="8,4" Margin="4,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsMoveTo, Converter={StaticResource BoolToVis}}"
                                                    Tag="{Binding}" />
                                        </Grid>
                                        <!-- Remove -->
                                        <Button Grid.Column="3" Content="×" Click="RemoveRule_Click" Tag="{Binding}"
                                                Padding="8,3" Margin="6,0,0,0" Foreground="#FFF38BA8" FontSize="14" VerticalAlignment="Center"
                                                AutomationProperties.Name="Remove rule" />
                                    </Grid>
                                    <TextBlock Text="{Binding OverlapWarning}" Foreground="#FFF9C74F" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasOverlapWarning, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFF38BA8" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add new rule -->
                <Border Background="#FF1E1E2E" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Add new rule" Foreground="#FFCDD6F4" FontWeight="SemiBold" FontSize="12" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewExtension, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" VerticalAlignment="Center"
                                     AutomationProperties.Name="New extension" />
                            <ComboBox Grid.Column="1" SelectedItem="{Binding NewAction, Mode=TwoWay}"
                                      Margin="6,0,0,0" VerticalAlignment="Center"
                                      ItemsSource="{Binding ActionOptions}"
                                      AutomationProperties.Name="New action" />
                            <Grid Grid.Column="2" Margin="6,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewDestination, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4" VerticalAlignment="Center"
                                         Visibility="{Binding IsNewMoveTo, Converter={StaticResource BoolToVis}}"
                                         AutomationProperties.Name="New destination" />
                                <Button Grid.Column="1" Content="Browse…" Click="BrowseNewDestination_Click"
                                        Padding="8,4" Margin="4,0,0,0"
                                        Visibility="{Binding IsNewMoveTo, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <Button Grid.Column="3" Content="Add" Click="AddRule_Click" Padding="14,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                    IsEnabled="{Binding CanAdd}" />
                        </Grid>
                        <TextBlock Text="{Binding NewOverlapHint}" Foreground="#FFF9C74F" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasNewOverlapHint, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding NewValidationMessage}" Foreground="#FFF38BA8" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasNewValidationError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Expander>
</UserControl>
