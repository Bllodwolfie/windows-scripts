<UserControl x:Class="ScriptSuite.Controls.SettingsForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ScriptSuite.ViewModels"
             xmlns:local="clr-namespace:ScriptSuite.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsFormViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One control per manifest field type (schema-driven). -->

        <DataTemplate x:Key="IntTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding IntText, UpdateSourceTrigger=PropertyChanged}"
                         Width="90" Padding="6,5" VerticalContentAlignment="Center"
                         LostFocus="Text_LostFocus" KeyDown="Text_KeyDown"
                         AutomationProperties.Name="{Binding Label}" />
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <Button Content="&#x25B2;" Click="StepUp_Click" Padding="7,1" FontSize="9"
                            AutomationProperties.Name="Increase" />
                    <Button Content="&#x25BC;" Click="StepDown_Click" Padding="7,1" FontSize="9" Margin="0,3,0,0"
                            AutomationProperties.Name="Decrease" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StringTemplate">
            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,5" LostFocus="Text_LostFocus" KeyDown="Text_KeyDown"
                     AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>

        <DataTemplate x:Key="PathTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,5" LostFocus="Text_LostFocus" KeyDown="Text_KeyDown"
                         AutomationProperties.Name="{Binding Label}" />
                <Button Grid.Column="1" Content="Browse…" Click="Browse_Click"
                        Padding="12,4" Margin="6,0,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BoolTemplate">
            <CheckBox IsChecked="{Binding BoolValue}" VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Label}">
                <TextBlock Text="Enabled" Foreground="{DynamicResource Brush.Foreground.Secondary}" />
            </CheckBox>
        </DataTemplate>

        <DataTemplate x:Key="ListTemplate">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Background.Card.Hover}" CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Foreground.Primary}" VerticalAlignment="Center" />
                                    <Button Content="&#x2715;" Click="ChipRemove_Click" FontSize="10" Padding="3,0"
                                            Margin="5,0,0,0" Foreground="{DynamicResource Brush.Status.Error}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            AutomationProperties.Name="Remove" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}" Width="220"
                             Padding="6,4" KeyDown="AddItem_KeyDown"
                             AutomationProperties.Name="Add item" />
                    <Button Content="Add" Click="AddItem_Click" Padding="12,4" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <local:FieldTemplateSelector x:Key="FieldTemplateSelector"
            IntTemplate="{StaticResource IntTemplate}"
            StringTemplate="{StaticResource StringTemplate}"
            PathTemplate="{StaticResource PathTemplate}"
            BoolTemplate="{StaticResource BoolTemplate}"
            ListTemplate="{StaticResource ListTemplate}" />

        <!-- One field row: label/unit, control slot, help text, Saved note. -->
        <DataTemplate x:Key="FieldRowTemplate" DataType="{x:Type vm:SettingsFieldViewModel}">
            <Border Background="{DynamicResource Brush.Background.Card}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Brush.Foreground.Primary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Unit}" Foreground="{DynamicResource Brush.Foreground.Tertiary}" FontSize="12"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding ShowUnit, Converter={StaticResource BoolToVis}}" />
                        <Button Grid.Column="2" Content="?" Width="22" Height="22" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.Accent.Primary}" Background="Transparent" BorderBrush="{DynamicResource Brush.Accent.Primary}" BorderThickness="1"
                                Visibility="{Binding HasHelpDetail, Converter={StaticResource BoolToVis}}"
                                Click="HelpToggle_Click" Tag="{Binding}"
                                AutomationProperties.Name="Help">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="11" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <ContentControl Margin="0,8,0,0" Content="{Binding}"
                                    ContentTemplateSelector="{StaticResource FieldTemplateSelector}" />

                    <TextBlock Text="{Binding HelpText}" Foreground="{DynamicResource Brush.Foreground.Help}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <Border Background="{DynamicResource Brush.Background.Primary}" CornerRadius="6" Padding="10" Margin="0,8,0,0"
                            Visibility="{Binding IsHelpExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding HelpDetail}" Foreground="{DynamicResource Brush.Foreground.Secondary}" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{Binding PathWarning}" Foreground="{DynamicResource Brush.Status.Warning.Text}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasPathWarning, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Brush.Status.Error}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="Saved" Foreground="{DynamicResource Brush.Status.Success}" FontSize="11" Margin="0,6,0,0"
                               Visibility="{Binding IsSavedShown, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Changes are saved automatically as you edit."
                       Foreground="{DynamicResource Brush.Foreground.Tertiary}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Undo" Click="Undo_Click" Padding="14,6"
                    IsEnabled="{Binding CanUndo}"
                    AutomationProperties.Name="Undo last change" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FieldList" ItemsSource="{Binding Fields}"
                          ItemTemplate="{StaticResource FieldRowTemplate}" />
        </ScrollViewer>
    </Grid>
</UserControl>

