<Window x:Class="ScriptSuite.ResumePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Script Suite — Interrupted Run" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Primary}" Foreground="{DynamicResource Brush.Foreground.Primary}">
    <Window.Resources>
        <!-- Button style now shared via Themes/Buttons.xaml -->
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#x26A0;" FontSize="20" Foreground="{DynamicResource Brush.Status.Warning.Text}" VerticalAlignment="Top" />
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Foreground.Primary}"
                       Margin="10,2,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="MessageText" FontSize="13" Foreground="{DynamicResource Brush.Foreground.Secondary}" TextWrapping="Wrap" Margin="30,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="DiscardButton" Content="Discard" Click="DiscardButton_Click"
                    Margin="0,0,8,0" AutomationProperties.Name="Discard" />
            <Button x:Name="ResumeButton" Content="Resume" Click="ResumeButton_Click"
                    FontWeight="SemiBold" IsDefault="True" AutomationProperties.Name="Resume" />
        </StackPanel>
    </StackPanel>
</Window>

