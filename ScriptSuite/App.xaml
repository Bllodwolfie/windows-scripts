<Application x:Class="ScriptSuite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScriptSuite"
             xmlns:conv="clr-namespace:ScriptSuite.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:BoolToMarginConverter x:Key="MarginConverter" />
    </Application.Resources>
</Application>