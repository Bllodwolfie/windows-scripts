<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>ScriptSuite.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.5" />
  </ItemGroup>

  <!-- Shipped assets: the .ps1 scripts stay the source of truth for logic and
       are deployed read-only alongside the exe; manifests describe them and
       default configs are copied to AppData on first run. -->
  <ItemGroup>
    <None Include="..\scripts\**\*.ps1" Exclude="..\scripts\m12_elevated_test\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="scripts\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\assets\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="Manifests\*.json" Exclude="Manifests\m12_elevated_test.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="DefaultConfigs\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
