<Window x:Class="ScriptSuite.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E" Foreground="#FFCDD6F4"
        ResizeMode="NoResize">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="#FFCDD6F4" />
        <TextBlock x:Name="DescText" Grid.Row="1" Margin="0,6,0,14" Foreground="#FFBAC2DE" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="IntervalBox" Width="60" Height="26" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="UnitBox" Width="120" Margin="8,0,0,0" Height="26">
                <ComboBoxItem Content="Days"/>
                <ComboBoxItem Content="Hours"/>
                <ComboBoxItem Content="Weeks"/>
            </ComboBox>
            <TextBlock Text="at" VerticalAlignment="Center" Margin="8,0,8,0"/>
            <TextBox x:Name="TimeBox" Width="70" Height="26" VerticalContentAlignment="Center" ToolTip="HH:mm e.g. 09:00"/>
        </StackPanel>

        <CheckBox x:Name="RiskCheck" Grid.Row="3" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Width="460" Foreground="#FFF9C74F">
                I understand the risks — this script will run unattended with the privileges shown above.
            </TextBlock>
        </CheckBox>
        <TextBlock x:Name="AdminNote" Grid.Row="4" Foreground="#FFF38BA8" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="This script requires administrator. Scheduling it will trigger a one-time UAC prompt to register the privileged task. After that runs silently forever after." Margin="0,0,0,10"/>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="#FFF38BA8" TextWrapping="Wrap" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Remove Schedule" Click="Remove_Click" Padding="12,6" Margin="0,0,8,0" x:Name="RemoveBtn"/>
            <Button Content="Cancel" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Save" Click="Save_Click" Padding="16,6" Background="#FF89B4FA" Foreground="#FF1E1E2E"/>
        </StackPanel>
    </Grid>
</Window>
