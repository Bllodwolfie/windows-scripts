<Window x:Class="ScriptSuite.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule" Height="540" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Primary}" Foreground="{DynamicResource Brush.Foreground.Primary}"
        ResizeMode="NoResize">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Foreground.Primary}" VerticalAlignment="Center" />
            <Button x:Name="ScheduleHelpButton" Grid.Column="1" Content="?" Width="22" Height="22" FontSize="11" FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.Accent.Primary}" Background="Transparent" BorderBrush="{DynamicResource Brush.Accent.Primary}" BorderThickness="1"
                    Click="ScheduleHelpButton_Click" VerticalAlignment="Center" AutomationProperties.Name="Help">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="11" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <Border x:Name="ScheduleHelpPanel" Grid.Row="1" Background="{DynamicResource Brush.Background.Primary}" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ScheduleHelpText" Foreground="{DynamicResource Brush.Foreground.Secondary}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <TextBlock x:Name="DescText" Grid.Row="2" Margin="0,6,0,12" Foreground="{DynamicResource Brush.Foreground.Secondary}" TextWrapping="Wrap" />

        <!-- Interval, Unit, Time -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="IntervalBox" Width="60" Height="26" VerticalContentAlignment="Center" TextChanged="Control_Changed"/>
            <ComboBox x:Name="UnitBox" Width="120" Margin="8,0,0,0" Height="26" SelectionChanged="UnitBox_SelectionChanged">
                <ComboBoxItem Content="Days"/>
                <ComboBoxItem Content="Hours"/>
                <ComboBoxItem Content="Weeks"/>
            </ComboBox>
            <TextBlock Text="at" VerticalAlignment="Center" Margin="8,0,8,0"/>
            <TextBox x:Name="TimeBox" Width="70" Height="26" VerticalContentAlignment="Center" ToolTip="HH:mm e.g. 09:00" TextChanged="Control_Changed"/>
        </StackPanel>

        <!-- Weekdays Selection (Weeks only) -->
        <StackPanel x:Name="WeekdaysPanel" Grid.Row="4" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock Text="Days of the week (at least one):" Margin="0,0,0,6" Foreground="{DynamicResource Brush.Foreground.Secondary}" FontSize="12"/>
            <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkMon" Content="Mon" Margin="0,0,12,0" Checked="Control_Changed" Unchecked="Control_Changed"/>
                <CheckBox x:Name="ChkTue" Content="Tue" Margin="0,0,12,0" Checked="Control_Changed" Unchecked="Control_Changed"/>
                <CheckBox x:Name="ChkWed" Content="Wed" Margin="0,0,12,0" Checked="Control_Changed" Unchecked="Control_Changed"/>
                <CheckBox x:Name="ChkThu" Content="Thu" Margin="0,0,12,0" Checked="Control_Changed" Unchecked="Control_Changed"/>
                <CheckBox x:Name="ChkFri" Content="Fri" Margin="0,0,12,0" Checked="Control_Changed" Unchecked="Control_Changed"/>
                <CheckBox x:Name="ChkSat" Content="Sat" Margin="0,0,12,0" Checked="Control_Changed" Unchecked="Control_Changed"/>
                <CheckBox x:Name="ChkSun" Content="Sun" Margin="0,0,12,0" Checked="Control_Changed" Unchecked="Control_Changed"/>
            </WrapPanel>
        </StackPanel>

        <!-- Start Date / Anchor Week -->
        <StackPanel x:Name="StartDatePanel" Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="StartDateLabel" Text="Start date:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="StartDatePicker" Width="150" Height="26" SelectedDateChanged="Control_Changed"/>
        </StackPanel>

        <!-- Live Next Run Preview -->
        <Border Grid.Row="6" Background="{DynamicResource Brush.Background.Secondary}" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
            <TextBlock x:Name="LivePreviewText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Primary}" Text="Next run: --" />
        </Border>

        <!-- Collision Warning Banner -->
        <Border x:Name="CollisionWarningPanel" Grid.Row="7" Background="#26FFA500" BorderBrush="{DynamicResource Brush.Status.Warning.Text}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="CollisionWarningText" Foreground="{DynamicResource Brush.Status.Warning.Text}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <CheckBox x:Name="RiskCheck" Grid.Row="8" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Width="460" Foreground="{DynamicResource Brush.Status.Warning.Text}">
                I understand the risks — this script will run unattended with the privileges shown above.
            </TextBlock>
        </CheckBox>

        <TextBlock x:Name="AdminNote" Grid.Row="9" Foreground="{DynamicResource Brush.Status.Error}" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="This script requires administrator. Scheduling it will trigger a one-time UAC prompt to register the privileged task. After that runs silently forever after." Margin="0,0,0,8"/>

        <TextBlock x:Name="ErrorText" Grid.Row="10" Foreground="{DynamicResource Brush.Status.Error}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Remove Schedule" Click="Remove_Click" Padding="12,6" Margin="0,0,8,0" x:Name="RemoveBtn"/>
            <Button Content="Cancel" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Save" Click="Save_Click" Padding="16,6" Background="{DynamicResource Brush.Accent.Primary}" Foreground="{DynamicResource Brush.Accent.Primary.Foreground}"/>
        </StackPanel>
    </Grid>
</Window>
