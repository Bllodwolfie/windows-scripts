<Window x:Class="ScriptSuite.ScriptRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScriptSuite.ViewModels"
        Title="Run Script" Height="620" Width="840"
        MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Primary}" Foreground="{DynamicResource Brush.Foreground.Primary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="RunHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RunSubText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- One selectable preview item -->
        <DataTemplate DataType="{x:Type vm:RunSelectionItem}">
            <Border Background="{DynamicResource Brush.Background.Card}" CornerRadius="6" Margin="0,0,0,4" Padding="8,6">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Target}"
                                  VerticalAlignment="Center"
                                  Checked="SelectionItem_Toggled" Unchecked="SelectionItem_Toggled">
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                <Border Background="{DynamicResource Brush.Background.Card.Hover}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActionDisplay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Foreground.Detail}" />
                                </Border>
                                <TextBlock Text="{Binding Target}" Foreground="{DynamicResource Brush.Foreground.Primary}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Foreground.Help}" FontSize="12"
                                   Margin="24,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,16,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NameText" Style="{StaticResource RunHeaderText}" />
                <TextBlock Text="&#x26E8;" FontSize="14" Foreground="{DynamicResource Brush.Status.Warning.Text}" VerticalAlignment="Center"
                           Margin="8,0,0,0" AutomationProperties.Name="Runs elevated"
                           x:Name="AdminIcon" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="DescriptionText" Style="{StaticResource RunSubText}" />
            <TextBlock Text="Runs elevated (UAC prompt appears when you confirm)."
                       Foreground="{DynamicResource Brush.Status.Warning.Text}" Margin="0,4,0,0" x:Name="AdminNote" Visibility="Collapsed" />
        </StackPanel>

        <!-- Preview / selection -->
        <StackPanel Grid.Row="1" x:Name="PreviewPanel" Margin="0,14,0,6">
            <TextBlock x:Name="ResumeBanner"
                       Text="Resuming an interrupted run — only the items still left to process are shown."
                       Foreground="{DynamicResource Brush.Status.Warning.Text}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="Collapsed" />
            <TextBlock x:Name="PreviewMessage" Style="{StaticResource RunSubText}" />
            <ListBox x:Name="SelectionList" Height="200" BorderThickness="0"
                     Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Margin="0,8,0,0" />
            <TextBlock x:Name="SelectionCountText" Foreground="{DynamicResource Brush.Foreground.Detail}" FontSize="13" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="1" x:Name="StatusText" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Foreground.Primary}" Margin="0,14,0,0" Visibility="Collapsed" />

        <!-- Live log -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Output" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Primary}" />
            <ListBox x:Name="LogList" Margin="0,6,0,0" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource Brush.Foreground.Secondary}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" Content="Confirm" Click="ConfirmButton_Click"
                    FontWeight="SemiBold" Padding="20,7" Margin="0,0,8,0" />
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" Padding="20,7" />
        </StackPanel>
    </Grid>
</Window>

