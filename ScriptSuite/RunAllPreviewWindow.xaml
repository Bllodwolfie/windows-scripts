<Window x:Class="ScriptSuite.RunAllPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScriptSuite.ViewModels"
        xmlns:conv="clr-namespace:ScriptSuite.Converters"
        mc:Ignorable="d"
        Title="Run All — Preview" Height="640" Width="900"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E" Foreground="#FFCDD6F4">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFCDD6F4" />
        </Style>

        <Style TargetType="TextBlock" x:Key="PreviewLine">
            <Setter Property="Foreground" Value="#FFBAC2DE" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FF313244" />
            <Setter Property="Foreground" Value="#FFCDD6F4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF45475A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One script's section: preview items before confirm, status/logs after -->
        <DataTemplate DataType="{x:Type vm:RunScriptPreviewItem}">
            <Border Background="#FF313244" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="&#x26E8;" FontSize="13" Foreground="#FFF9C74F"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowAdminShield, Converter={StaticResource BoolToVis}}"
                                       AutomationProperties.Name="Requires administrator" />
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitle}"
                                       Margin="{Binding ShowAdminShield, Converter={StaticResource MarginConverter}, ConverterParameter=8}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold"
                                   Foreground="#FF89B4FA" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Preview items -->
                    <ItemsControl ItemsSource="{Binding PreviewItems}"
                                  Visibility="{Binding HasPreviewItems, Converter={StaticResource BoolToVis}}"
                                  Margin="24,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource PreviewLine}">
                                    <Run Text="{Binding Action}" FontWeight="Bold" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Target}" />
                                    <Run Text="  —  " Foreground="#FF6C7086" />
                                    <Run Text="{Binding Detail}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- No-preview note (read-only scripts, or preview error) -->
                    <TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource PreviewLine}"
                               Visibility="{Binding HasPreviewItems, Converter={StaticResource InverseBoolToVis}}"
                               Margin="24,6,0,0" Foreground="#FFA6E3A1" />

                    <!-- Logs once run -->
                    <Expander Header="Logs" Margin="24,8,0,0" Foreground="#FFBAC2DE"
                              Visibility="{Binding HasLogs, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Logs}" Margin="4,6,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource PreviewLine}"
                                               FontFamily="Consolas" FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Run All — Preview" FontSize="24" FontWeight="Bold" Foreground="#FFCDD6F4" />
            <TextBlock Text="This is what each enabled script would do. EmptyRecycleBin always runs first in the batch."
                       Foreground="#FFBAC2DE" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
            <ItemsControl x:Name="SectionList" />
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="ProgressText" Foreground="#FFA6E3A1" Margin="0,0,0,8"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <Button x:Name="ConfirmButton" Content="Confirm and run all" Click="ConfirmButton_Click"
                    FontWeight="SemiBold" Padding="22,10" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>