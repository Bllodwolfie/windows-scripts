<Window x:Class="ScriptSuite.ScheduledHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScriptSuite.ViewModels"
        xmlns:conv="clr-namespace:ScriptSuite.Converters"
        Title="Scheduled History" Height="560" Width="860"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background.Primary}" Foreground="{DynamicResource Brush.Foreground.Primary}">
    <Window.Resources>
        <conv:OutcomeToBrushConverter x:Key="OutcomeToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="HistoryTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}" />
        </Style>

        <Style x:Key="HistorySubtext" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Root cause: this DataTemplate was missing entirely. Without an
             explicit template an ItemsControl falls back to calling
             ToString() on each item, which for HistoryRowViewModel yields
             the literal type name ScriptSuite.ViewModels.HistoryRowViewModel.
             This is the same template HistoryWindow already uses, so
             scheduled rows now render identically: timestamp, display name
             with trigger, summary, and outcome badge with distinct colors
             (Success green, Warning yellow, Failed red, SkippedBusy blue)
             as produced by ScheduledHistoryWindow.xaml.cs. -->
        <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
            <Border Background="{DynamicResource Brush.Background.Card}" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="158" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding When}" Foreground="{DynamicResource Brush.Foreground.Tertiary}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource HistoryTitleText}" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource HistorySubtext}"
                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{Binding Outcome, Converter={StaticResource OutcomeToBrush}}" CornerRadius="4"
                            Padding="8,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Outcome}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Status.Success.Foreground}" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Scheduled Runs" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Foreground.Primary}"/>
            <TextBlock x:Name="CountText" Foreground="{DynamicResource Brush.Foreground.Secondary}" Margin="0,4,0,0"/>
            <TextBlock Text="Results only visible here (no notifications). Skipped — app was busy is a distinct outcome, not silently dropped." Foreground="{DynamicResource Brush.Foreground.Tertiary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock x:Name="EmptyMessage" Grid.Row="1" Text="No scheduled runs yet." Foreground="{DynamicResource Brush.Foreground.Tertiary}" Margin="0,18,0,6"/>
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryList"/>
        </ScrollViewer>
    </Grid>
</Window>


